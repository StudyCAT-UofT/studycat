# Database and quiz engine connections.
# These are set by docker-compose.yml for the containers (which reach the database and quiz
# engine by service name, not localhost), so they are only needed when running the app outside
# Docker. Uncomment them in that case.
# DATABASE_URL="postgresql://studycat:studycatPassword123!@localhost:5432/studycat?schema=public"
# FASTAPI_BASE_URL=http://localhost:8000/v1

# For switching between simple and Shibboleth login
AUTH_MODE=shibboleth
# Required for client-side auth mode detection (Next.js only exposes NEXT_PUBLIC_* vars to the browser)
NEXT_PUBLIC_AUTH_MODE=shibboleth
ENABLE_MOCK_SHIBBOLETH=true

# JWT session signing — CHANGE JWT_SECRET to a strong random value before use
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Generic until SP is finalized
SHIBBOLETH_SP_URL=https://sp.studycat.local
SHIBBOLETH_LOGIN_URL=https://sp.studycat.local/Shibboleth.sso/Login
SHIBBOLETH_LOGOUT_URL=https://sp.studycat.local/Shibboleth.sso/Logout
