# Database and quiz engine connections.
# These are set by docker-compose.yml for the containers (which reach the database and quiz
# engine by service name, not localhost), so they are only needed when running the app outside
# Docker. Uncomment them in that case.
# DATABASE_URL="postgresql://catalyze:catalyzePassword123!@localhost:5432/catalyze?schema=public"
# FASTAPI_BASE_URL=http://localhost:8000/v1

# For switching between simple and Shibboleth login
AUTH_MODE=shibboleth
# Required for client-side auth mode detection (Next.js only exposes NEXT_PUBLIC_* vars to the browser).
# This value is baked into the browser code by `next build`, so it must be set when building,
# and changing it requires a rebuild (setting it only at runtime has no effect on the login page).
NEXT_PUBLIC_AUTH_MODE=shibboleth
ENABLE_MOCK_SHIBBOLETH=true
# Where the browser reaches the Shibboleth SP. Needed in local development when you open the
# dev server directly (http://localhost:3001); leave it unset when Apache/mod_shib serves the
# app on the same host (e.g. production), so the app uses relative /Shibboleth.sso/... paths.
# Like NEXT_PUBLIC_AUTH_MODE, it is read at build time (or when `next dev` starts).
NEXT_PUBLIC_SHIBBOLETH_SP_URL=https://sp.studycat.local

# JWT session signing — CHANGE JWT_SECRET to a strong random value before use
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
