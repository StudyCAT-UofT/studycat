generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

//
// ========== Enums ==========
//

enum OfferingRole {
    STUDENT
    TA
    INSTRUCTOR
}

enum BloomCategory {
    REMEMBER
    UNDERSTAND
    APPLY
    ANALYZE
    EVALUATE
    CREATE
}

enum OptionLabel {
    A
    B
    C
    D
}

enum AttemptStatus {
    IN_PROGRESS
    COMPLETED
    ABANDONED
}

//
// ========== Core Auth & Roster ==========
//

model User {
    id        String   @id @default(cuid())
    username  String   @unique
    createdAt DateTime @default(now())

    // Relations
    enrollments Enrollment[]
    attempts    Attempt[]
    quizzes     Quiz[]       @relation("QuizCreatedBy")
}

model Course {
    id        String   @id @default(cuid())
    code      String
    title     String
    createdAt DateTime @default(now())

    // Relations
    offerings CourseOffering[]
    items     Item[]

    @@unique([code, title])
}

model Term {
    id        String    @id @default(cuid())
    name      String // e.g., "Fall 2025"
    startDate DateTime?
    endDate   DateTime?

    // Relations
    offerings CourseOffering[]

    @@unique([name])
}

model CourseOffering {
    id       String  @id @default(cuid())
    courseId String
    termId   String
    display  String?

    createdAt DateTime @default(now())

    // Relations
    course  Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
    term    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
    enrolls Enrollment[]
    quizzes Quiz[]

    @@unique([courseId, termId])
    @@index([termId])
    @@index([courseId])
}

model Enrollment {
    id           String       @id @default(cuid())
    userId       String
    offeringId   String
    // Role at offering-level (can mirror the global role; useful if you later diverge)
    offeringRole OfferingRole @default(STUDENT)
    createdAt    DateTime     @default(now())

    // Relations
    user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    offering CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)

    @@unique([userId, offeringId])
    @@index([offeringId])
    @@index([offeringRole])
}

//
// ========== Item Bank (per Course) ==========
// Imported from spreadsheet: 
// Module, Question_ID, Bloom_Cat, Stem, Reference, Response_A..D, Justification_A..D,
// Figure, PtBi, Average, Attempts, IRT_a, IRT_b, IRT_c
//

model Item {
    id                 String        @id @default(cuid())
    courseId           String
    externalQuestionId String // Spreadsheet "Question_ID" (stable within a course)
    module             String // Spreadsheet "Module" (used as "concept" axis in MVP)
    bloom              BloomCategory // Standardized from spreadsheet Bloom_Cat
    stem               String // Rich text/markdown-safe; plain string in MVP
    reference          String? // Spreadsheet "Reference"
    figureUrl          String? // Spreadsheet "Figure" (URL)
    ptBi               Float? // Spreadsheet "PtBi"
    average            Float? // Spreadsheet "Average"
    attemptsCount      Int? // Spreadsheet "Attempts"

    // IRT params (3PL)
    irtA Float // Spreadsheet "IRT_a"
    irtB Float // Spreadsheet "IRT_b"
    irtC Float // Spreadsheet "IRT_c"

    // Operational
    active    Boolean  @default(true)
    createdAt DateTime @default(now())

    // Relations
    course    Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
    options   ItemOption[]
    quizLinks QuizItem[] // Explicit includes to quizzes
    responses Response[]

    @@unique([courseId, externalQuestionId]) // Stable per course
    @@index([courseId])
    @@index([module])
    @@index([bloom])
    @@index([active])
}

model ItemOption {
    id            String      @id @default(cuid())
    itemId        String
    label         OptionLabel // A, B, C, D
    text          String // Spreadsheet "Response_X"
    justification String? // Spreadsheet "Justification_X"
    isCorrect     Boolean // Derived from bolded cell in sheet during import

    // Relations
    item     Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
    Response Response[]

    @@unique([itemId, label])
    @@index([isCorrect])
}

//
// ========== Quizzes (per Offering) ==========
// Instructor-created; fixed length; students can attempt unlimited times.
// Scope can be defined both by filters (modules/blooms) and explicit item selection.
//

model Quiz {
    id          String  @id @default(cuid())
    offeringId  String
    title       String
    fixedLength Int // N items per attempt
    active      Boolean @default(true)

    // Filter-based scope (optional). Explicit selection via QuizItem is also supported.
    // Modules correspond to Item.module strings from the bank.
    includedModules String[]        @default([])
    includedBlooms  BloomCategory[] @default([])

    // Audit
    createdById String?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    offering  CourseOffering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
    createdBy User?          @relation("QuizCreatedBy", fields: [createdById], references: [id])
    quizItems QuizItem[]
    attempts  Attempt[]

    @@index([offeringId])
    @@index([active])
}

model QuizItem {
    // Explicit include of particular items into a quiz scope
    quizId String
    itemId String

    quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
    item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

    @@id([quizId, itemId])
    @@index([itemId])
}

//
// ========== Attempts & Responses ==========
// Unlimited attempts, autosave, per-response timing, correctness, engine snapshots.
//

model Attempt {
    id         String        @id @default(cuid())
    quizId     String
    userId     String
    startedAt  DateTime      @default(now())
    finishedAt DateTime?
    status     AttemptStatus @default(IN_PROGRESS)

    // Copy of quiz length at start for audit
    fixedLengthN Int

    // Engine metadata and audit
    engineVersion         String? // Provided by engine or set by integrator
    // Snapshot of eligible items the client computed at start (IDs & filters)
    scopeSnapshot         Json? // {includedModules, includedBlooms, eligibleItemIds: [...]}
    // Final mastery vector returned by engine (per-module) at finish (optional)
    engineMasteryAtFinish Json?

    // Relations
    quiz      Quiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
    user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    responses Response[]

    @@index([quizId])
    @@index([userId])
    @@index([status])
    @@index([startedAt])
}

model Response {
    id            String      @id @default(cuid())
    attemptId     String
    itemId        String
    // Selected option (redundant to itemOptionId for fast analytics & robustness)
    selectedLabel OptionLabel
    itemOptionId  String? // The actual ItemOption chosen (if you want FK safety)

    isCorrect      Boolean
    askedAt        DateTime // When question was shown
    answeredAt     DateTime // When answer was submitted
    responseTimeMs Int // Convenience: answeredAt - askedAt in ms

    // Optional mastery vector snapshot (per-module) after *this* response
    engineMasterySnapshot Json?

    // Relations
    attempt    Attempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
    item       Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
    itemOption ItemOption? @relation(fields: [itemOptionId], references: [id], onDelete: SetNull)

    @@index([attemptId])
    @@index([itemId])
    @@index([isCorrect])
    @@index([answeredAt])
}
