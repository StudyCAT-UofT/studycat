<Attributes xmlns="urn:mace:shibboleth:2.0:attribute-map" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
    StudyCAT Attribute Mapping (Simplified)

    The application only uses 'uid' for user identification (with 'eppn' as fallback).
    See app/api/auth/shibboleth/callback/route.ts for usage.

    These attributes are exported as HTTP headers:
    - HTTP_UID (username) - primary identifier
    - HTTP_EPPN (eduPersonPrincipalName) - fallback identifier
    -->

    <!-- uid - Username (primary identifier for StudyCAT) -->
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.1" id="uid"/>

    <!-- eduPersonPrincipalName (eppn) - Scoped username as fallback -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.6" id="eppn">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>

</Attributes>
