<Attributes xmlns="urn:mace:shibboleth:3.0:attribute-map" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!--
    StudyCAT Attribute Mapping
    Maps SAML attributes from IdP to environment variables and HTTP headers
    
    Attribute format:
    - name: SAML attribute name (OID or URI)
    - id: Internal SP attribute ID (used in REMOTE_USER, exported as HTTP header)
    - nameFormat: The SAML attribute name format
    -->

    <!-- eduPersonPrincipalName (eppn) - Primary user identifier -->
    <Attribute name="urn:mace:dir:attribute-def:eduPersonPrincipalName" id="eppn">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.6" id="eppn">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>

    <!-- uid - Username -->
    <Attribute name="urn:mace:dir:attribute-def:uid" id="uid"/>
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.1" id="uid"/>

    <!-- mail - Email address -->
    <Attribute name="urn:mace:dir:attribute-def:mail" id="mail"/>
    <Attribute name="urn:oid:0.9.2342.19200300.100.1.3" id="mail"/>

    <!-- displayName - User's display name -->
    <Attribute name="urn:mace:dir:attribute-def:displayName" id="displayName"/>
    <Attribute name="urn:oid:2.16.840.1.113730.3.1.241" id="displayName"/>

    <!-- cn - Common Name -->
    <Attribute name="urn:mace:dir:attribute-def:cn" id="cn"/>
    <Attribute name="urn:oid:2.5.4.3" id="cn"/>

    <!-- sn - Surname -->
    <Attribute name="urn:mace:dir:attribute-def:sn" id="sn"/>
    <Attribute name="urn:oid:2.5.4.4" id="sn"/>

    <!-- givenName - First name -->
    <Attribute name="urn:mace:dir:attribute-def:givenName" id="givenName"/>
    <Attribute name="urn:oid:2.5.4.42" id="givenName"/>

    <!-- eduPersonAffiliation - User's role/affiliation (student, faculty, staff) -->
    <Attribute name="urn:mace:dir:attribute-def:eduPersonAffiliation" id="affiliation">
        <AttributeDecoder xsi:type="StringAttributeDecoder" caseSensitive="false"/>
    </Attribute>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.1" id="affiliation">
        <AttributeDecoder xsi:type="StringAttributeDecoder" caseSensitive="false"/>
    </Attribute>

    <!-- eduPersonScopedAffiliation - Scoped affiliation -->
    <Attribute name="urn:mace:dir:attribute-def:eduPersonScopedAffiliation" id="scoped-affiliation">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.9" id="scoped-affiliation">
        <AttributeDecoder xsi:type="ScopedAttributeDecoder" caseSensitive="false"/>
    </Attribute>

    <!-- eduPersonEntitlement - Specific entitlements/permissions -->
    <Attribute name="urn:mace:dir:attribute-def:eduPersonEntitlement" id="entitlement"/>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.7" id="entitlement"/>

    <!-- eduPersonPrimaryAffiliation - Primary affiliation -->
    <Attribute name="urn:mace:dir:attribute-def:eduPersonPrimaryAffiliation" id="primary-affiliation">
        <AttributeDecoder xsi:type="StringAttributeDecoder" caseSensitive="false"/>
    </Attribute>
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.5" id="primary-affiliation">
        <AttributeDecoder xsi:type="StringAttributeDecoder" caseSensitive="false"/>
    </Attribute>

    <!-- eduPersonTargetedID - Persistent opaque identifier -->
    <Attribute name="urn:oid:1.3.6.1.4.1.5923.1.1.1.10" id="targeted-id">
        <AttributeDecoder xsi:type="NameIDAttributeDecoder" formatter="$NameQualifier!$SPNameQualifier!$Name"/>
    </Attribute>

    <!--
    These attributes will be exported as HTTP headers to the application:
    - HTTP_EPPN (eduPersonPrincipalName)
    - HTTP_UID (username)
    - HTTP_MAIL (email)
    - HTTP_DISPLAYNAME (display name)
    - HTTP_AFFILIATION (role: student, faculty, staff, member)
    - HTTP_SCOPED_AFFILIATION (scoped role)
    
    The StudyCAT application will read these headers to identify and authorize users.
    -->

</Attributes>
