<?xml version="1.0" encoding="UTF-8"?>
<!-- 
    StudyCAT Mock IdP - Attribute Filter Policy
    For development: releases all attributes to any Service Provider
    
    WARNING: This is NOT suitable for production. In production, you should
    restrict attribute release to specific SPs based on their entity ID.
-->
<AttributeFilterPolicyGroup id="ShibbolethFilterPolicy"
        xmlns="urn:mace:shibboleth:2.0:afp"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:mace:shibboleth:2.0:afp http://shibboleth.net/schema/idp/shibboleth-afp.xsd">

    <!-- 
        Release all attributes to any Service Provider 
        This is appropriate for development/testing environments
    -->
    <AttributeFilterPolicy id="releaseToAnySP">
        <PolicyRequirementRule xsi:type="ANY" />
        
        <!-- Release eduPersonPrincipalName (eppn) -->
        <AttributeRule attributeID="eduPersonPrincipalName" permitAny="true" />
        
        <!-- Release uid (username) -->
        <AttributeRule attributeID="uid" permitAny="true" />
        
        <!-- Release mail (email) -->
        <AttributeRule attributeID="mail" permitAny="true" />
        
        <!-- Release displayName -->
        <AttributeRule attributeID="displayName" permitAny="true" />
        
        <!-- Release eduPersonScopedAffiliation (role) -->
        <AttributeRule attributeID="eduPersonScopedAffiliation" permitAny="true" />
        
        <!-- Release eduPersonAffiliation (unscoped role) -->
        <AttributeRule attributeID="eduPersonAffiliation" permitAny="true" />
    </AttributeFilterPolicy>
    
</AttributeFilterPolicyGroup>
