{
  "name": "studycat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx scripts/seed.ts",
    "db:generate": "prisma generate --schema=external/studycat-schema/schema.prisma --generator=client",
    "db:migrate": "prisma migrate dev --schema=external/studycat-schema/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=external/studycat-schema/schema.prisma",
    "db:migrate:reset": "prisma migrate reset --schema=external/studycat-schema/schema.prisma",
    "db:studio": "prisma studio --schema=external/studycat-schema/schema.prisma",
    "db:status": "prisma migrate status --schema=external/studycat-schema/schema.prisma"
  },
  "dependencies": {
    "@mantine/core": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/notifications": "^8.3.6",
    "@prisma/client": "^6.16.2",
    "@tabler/icons-react": "^3.35.0",
    "clsx": "^2.1.1",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "mantine-datatable": "^8.2.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^6.16.2",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
