{
  "name": "studycat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:css": "stylelint \"app/**/*.css\"",
    "test": "vitest --config vitest.config.mts",
    "test:ui": "vitest --ui --config vitest.config.mts",
    "test:run": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:basic": "tsx scripts/basic_seed.ts",
    "db:generate": "prisma generate --schema=external/studycat-schema/schema.prisma --generator=client",
    "db:migrate": "prisma migrate dev --schema=external/studycat-schema/schema.prisma --skip-generate",
    "db:migrate:deploy": "prisma migrate deploy --schema=external/studycat-schema/schema.prisma --skip-generate",
    "db:migrate:reset": "prisma migrate reset --schema=external/studycat-schema/schema.prisma --force --skip-generate",
    "db:studio": "prisma studio --schema=external/studycat-schema/schema.prisma",
    "db:status": "prisma migrate status --schema=external/studycat-schema/schema.prisma"
  },
  "dependencies": {
    "@mantine/charts": "^8.3.7",
    "@mantine/core": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/notifications": "^8.3.6",
    "@prisma/client": "^6.16.2",
    "@tabler/icons-react": "^3.35.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "js-cookie": "^3.0.7",
    "jsonwebtoken": "^9.0.3",
    "mantine-datatable": "^8.2.0",
    "next": "^15.5.22",
    "papaparse": "^5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "4.0.10",
    "@vitest/ui": "^4.0.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^30.0.0",
    "msw": "^2.12.14",
    "postcss": "^8.5.18",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^6.16.2",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}